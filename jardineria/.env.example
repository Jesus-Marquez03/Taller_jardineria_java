# Copia este archivo como .env y reemplaza las contrasenas de ejemplo.
# Si el puerto 3306 esta ocupado, usa MYSQL_PORT=3307.
MYSQL_DATABASE=jardineria
MYSQL_USER=jardineria_app
MYSQL_PASSWORD=cambia_esta_contrasena
MYSQL_ROOT_PASSWORD=cambia_esta_contrasena_root
MYSQL_PORT=3306
TZ=America/Bogota

# Variables que lee la aplicacion Java.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jardineria
DB_USER=jardineria_app
DB_PASSWORD=cambia_esta_contrasena
